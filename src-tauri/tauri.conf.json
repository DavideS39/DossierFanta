{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DossierFanta",
  "version": "0.1.0",
  "identifier": "com.dossierfanta.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DossierFanta — Taccuino v2.2",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 DossierFanta",
    "category": "Utility",
    "shortDescription": "Taccuino di progettazione fantacalcio",
    "longDescription": "App desktop nativa per gestione rosa fantacalcio con storage locale SQLite. M1: base offline funzionante.",
    "windows": {
      "wix": {
        "language": "it-IT",
        "fragmentPaths": [],
        "componentRefs": [],
        "featureRefs": []
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {}
}
